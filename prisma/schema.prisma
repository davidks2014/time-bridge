// =========================================
// Prisma Client
// =========================================
generator client {
  provider = "prisma-client-js"
}

// =========================================
// Database
// =========================================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================
// Enums
// =========================================

/**
 * Attachment type:
 * - IMAGE : image file attached to a message
 * - VIDEO : video file attached to a message
 */
enum AttachmentType {
  IMAGE
  VIDEO
}

/**
 * Release status:
 * - DRAFT    : private, not released
 * - RELEASED : receiver can see
 */
enum MemoryItemStatus {
  DRAFT
  RELEASED
}

/**
 * Optional: Collection status
 */
enum CollectionStatus {
  DRAFT
  ACTIVE
}

/**
 * User role for Admin review feature
 * - USER  : normal user
 * - ADMIN : can approve/reject ID verification
 */
enum UserRole {
  USER
  ADMIN
}

/**
 * Manual identity verification status (admin review queue)
 */
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Proof-of-life stage for the 3-stage escalation system
 * - NORMAL   : sender is within their confirmation window
 * - WARNING  : sender is approaching their deadline (day 25-29)
 * - CRITICAL : sender has missed confirmations, trusted contact alerted
 */
enum ProofOfLifeStage {
  NORMAL
  WARNING
  CRITICAL
}

/**
 * Receiver type — determines delivery path when memory is released
 * - ADULT   : receiver is an adult, email delivery direct
 * - CHILD   : receiver is a child, guardian handles delivery
 * - UNKNOWN : contact details not yet known, guardian or admin handles
 */
enum ReceiverType {
  ADULT
  CHILD
  UNKNOWN
}

/**
 * Visit outcome — recorded by admin after each physical visit attempt
 */
enum VisitOutcome {
  DELIVERED_AND_ACKNOWLEDGED
  LEFT_LETTER_NO_ONE_HOME
  ADDRESS_NOT_FOUND
  PERSON_CONFIRMED_NOT_RECEIVER
  REDIRECTED_TO_GUARDIAN
  OTHER
}

/**
 * Delivery channel used to reach the receiver
 */
enum DeliveryChannel {
  EMAIL
  SMS
  GUARDIAN
  TRUSTED_CONTACT
  PHYSICAL_VISIT
  ADMIN
}

/**
 * Delivery attempt status
 */
enum DeliveryStatus {
  SENT
  DELIVERED
  FAILED
  BOUNCED
  PENDING
}

/**
 * Consent type — what the user agreed to
 */
enum ConsentType {
  DATA_COLLECTION
  LEGACY_DELIVERY
  RECEIVER_CONTACT
  TERMS_AND_PRIVACY
}

// =========================================
// NextAuth Models
// =========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =========================================
// App Models
// =========================================

model User {
  // =========================================
  // Primary Identity
  // =========================================
  id    String @id @default(cuid())
  email String @unique
  name  String

  // =========================================
  // Role / Admin
  // =========================================
  role UserRole @default(USER)

  // =========================================
  // Authentication
  // =========================================
  passwordHash String

  // =========================================
  // Mandatory Profile Fields
  // =========================================
  phoneNumber      String
  identificationNo String
  address          String

  // =========================================
  // Proof-of-Life System
  // =========================================
  lastConfirmedAt          DateTime?
  missedConfirmations      Int       @default(0)
  confirmationIntervalDays Int       @default(30)

  // =========================================
  // Proof-of-Life Stage Tracking
  // =========================================
  // Tracks which escalation stage the sender is currently in
  // Updated by the proof-of-life cron job
  proofOfLifeStage ProofOfLifeStage @default(NORMAL)

  // =========================================
  // Holiday Snooze
  // =========================================
  // If set, proof-of-life checks are paused until this date
  // Sender can activate this when going on holiday or having a procedure
  snoozedUntil DateTime?

  // =========================================
  // Trusted Contact
  // =========================================
  // A trusted person who is alerted if sender becomes unresponsive
  // They help confirm whether sender is alive or has passed
  // They never see the memory content — only the sender's status
  trustedContactName  String?
  trustedContactNric  String?
  trustedContactEmail String?
  trustedContactPhone String?

  // =========================================
  // Consent Records
  // =========================================
  consents ConsentRecord[]

  // Device fingerprints for suspicious login detection
  deviceFingerprints DeviceFingerprint[]

  // =========================================
  // Storage Quota System
  // =========================================
  // 50MB free quota by default
  storageUsedBytes  BigInt @default(0)
  storageLimitBytes BigInt @default(52428800)

  // =========================================
  // NextAuth Relations
  // =========================================
  accounts Account[]
  sessions Session[]

  // =========================================
  // App Relations (Owner side)
  // =========================================
  receivers   Receiver[]
  collections MemoryCollection[]
  items       MemoryItem[]

  // =========================================
  // Receiver Account Linking
  // =========================================
  linkedReceivers Receiver[] @relation("ReceiverLinkedUser")

  // =========================================
  // Identity verification requests
  // =========================================
  verificationRequests IdentityVerificationRequest[] @relation("VerificationRequester")

  // =========================================
  // Manual identity verification
  // =========================================
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectReason       String?

  // =========================================
  // Verification Documents
  // =========================================
  verificationDocFrontUrl String?
  verificationDocBackUrl  String?

  // Optional: store Cloudinary public IDs too for cleanup
  verificationDocFrontPublicId String?
  verificationDocBackPublicId  String?

  // =========================================
  // Timestamps
  // =========================================
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Receiver {
  id String @id @default(cuid())

  // Owner of this receiver record
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Mandatory receiver details
  fullName         String
  email            String
  phone            String
  address          String
  identificationNo String

  // =========================================
  // Receiver Type
  // =========================================
  // Determines the delivery path when a memory is released
  // ADULT = direct email delivery
  // CHILD = guardian handles delivery
  // UNKNOWN = no contact details yet, guardian or admin handles
  receiverType ReceiverType @default(ADULT)

  // =========================================
  // Guardian Details
  // =========================================
  // Only required when receiverType is CHILD or UNKNOWN
  // Guardian is a trusted adult who holds the message for the child
  // Guardian never sees memory content — they are only a delivery bridge
  guardianName    String?
  guardianNric    String?
  guardianEmail   String?
  guardianPhone   String?
  guardianAddress String?

  // =========================================
  // Visit Logs
  // =========================================
  // Physical visit attempts made by admin when digital delivery failed
  visitLogs VisitLog[]

  // =========================================
  // Delivery Attempts
  // =========================================
  deliveryAttempts DeliveryAttempt[]

  // Invitation legacy fields
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  // Linked actual receiver account
  linkedUserId String?
  linkedUser   User?   @relation("ReceiverLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  // Collections that target this receiver
  collections MemoryCollection[]

  // Invite relation
  invites ReceiverInvite[]

  // Identity verification requests
  verificationRequests IdentityVerificationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([ownerId])
  @@index([identificationNo])
}

model MemoryCollection {
  id String @id @default(cuid())

  // The "card" owner
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // The receiver for this card
  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  // Card title
  title String

  // Optional status
  status CollectionStatus @default(DRAFT)

  // Items inside this collection
  items MemoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([receiverId])
}

model MemoryItem {
  id String @id @default(cuid())

  // Parent collection (the "card")
  collectionId String
  collection   MemoryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Owner (creator)
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Message title
  title String

  // Message text content
  content String

  // Optional per-item release date
  releaseDate DateTime?
  releasedAt  DateTime?
  // When the receiver first viewed/opened this memory item
  // Null means released but not yet viewed by receiver
  viewedAt    DateTime?

  // Release status
  status MemoryItemStatus @default(DRAFT)

  // Optional attachments (image/video)
  attachments MemoryAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([collectionId])
  @@index([releaseDate])
  @@index([status])
}

model MemoryAttachment {
  id String @id @default(cuid())

  // Parent message item
  itemId String
  item   MemoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Attachment type
  type AttachmentType

  // Cloudinary / media metadata
  mediaUrl       String
  mediaPublicId  String
  mediaFileName  String?
  mediaMimeType  String?
  mediaSizeBytes BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([type])
}

model ReceiverInvite {
  id String @id @default(cuid())

  token String @unique

  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  // Snapshot info at invite generation time
  receiverEmail String
  receiverName  String?

  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([receiverId])
  @@index([createdAt])
}

/**
 * Admin review queue for Scenario A:
 * - Receiver clicks invite link
 * - Enters identificationNo + creates login email/password
 * - Uploads ID photo proof
 * - Admin reviews and approves
 * - After approve: Receiver.linkedUserId is set
 */
model IdentityVerificationRequest {
  id String @id @default(cuid())

  // Which receiver record is being claimed
  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  // Who is requesting
  requesterUserId String
  requesterUser   User   @relation("VerificationRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  // Which invite token was used
  inviteTokenUsed String?

  // Identification number submitted in the claim form
  identificationNoSubmitted String

  // Uploaded ID images
  idImageFrontUrl String
  idImageBackUrl  String?

  // Optional Cloudinary public IDs for cleanup
  idImageFrontPublicId String?
  idImageBackPublicId  String?

  // Admin review result
  status       VerificationStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedBy   String?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId])
  @@index([requesterUserId])
  @@index([status])
}

// =========================================
// Visit Log
// =========================================
// Records every physical visit attempt made by admin
// Used when all digital delivery channels have failed
model VisitLog {
  id String @id @default(cuid())

  // Which receiver this visit was for
  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  // When the visit was attempted
  visitDate DateTime

  // What happened during the visit
  outcome VisitOutcome

  // Optional notes from the admin about the visit
  adminNotes String?

  // Claim code issued during this visit — receiver uses this to fast-track online claim
  claimCode          String?   @unique
  claimCodeExpiresAt DateTime?

  // Which admin conducted the visit
  conductedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId])
}

// =========================================
// Audit Log
// =========================================
// Records every important system action for accountability
// Critical for a legacy app — we must always know what happened and when
model AuditLog {
  id String @id @default(cuid())

  // What action was performed e.g. "MEMORY_RELEASED", "INVITE_SENT", "ADMIN_APPROVED"
  action String

  // What type of entity was affected e.g. "MemoryItem", "User", "Receiver"
  entity String

  // The ID of the affected entity
  entityId String

  // Who performed the action — user ID or "SYSTEM" for automated actions
  performedBy String

  // Optional JSON details about the action for debugging
  details String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([performedBy])
  @@index([createdAt])
}

// =========================================
// Consent Record
// =========================================
// Stores proof that a user gave explicit consent at a specific time
// Required for PDPA compliance — we must be able to prove consent was given
model ConsentRecord {
  id String @id @default(cuid())

  // Which user gave consent
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What they consented to
  consentType ConsentType

  // IP address at time of consent — for legal proof
  ipAddress String?

  // Exact timestamp of consent — stored separately from createdAt for clarity
  consentGivenAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([consentType])
}

// =========================================
// Delivery Attempt
// =========================================
// Tracks every attempt to reach a receiver across all channels
// Gives admin a clear picture of what has been tried before escalating
model DeliveryAttempt {
  id String @id @default(cuid())

  // Which receiver this attempt was for
  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  // Which channel was used
  channel DeliveryChannel

  // What happened
  status DeliveryStatus

  // When the attempt was made
  attemptedAt DateTime @default(now())

  // Optional notes e.g. bounce reason, SMS error code
  notes String?

  createdAt DateTime @default(now())

  @@index([receiverId])
  @@index([channel])
  @@index([status])
}
// =========================================
// Device Fingerprint
// =========================================
// Tracks known devices for each user
// Used to detect suspicious logins during unresponsive periods
// If a new device logs in while sender is in WARNING/CRITICAL stage,
// admin is alerted to investigate before memories are released

model DeviceFingerprint {
  id String @id @default(cuid())

  // Which user this fingerprint belongs to
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hash of user-agent + rough IP prefix (not exact IP for privacy)
  // We hash it so we never store raw device data
  fingerprintHash String

  // Human readable label for admin display
  // e.g. "Chrome on Mac" or "Safari on iPhone"
  deviceLabel String?

  // When this device was first seen
  firstSeenAt DateTime @default(now())

  // When this device last logged in
  lastSeenAt DateTime @default(now())

  // Whether this login was flagged as suspicious
  // (new device during WARNING/CRITICAL stage)
  flagged Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([userId, fingerprintHash])
  @@index([userId])
  @@index([flagged])
}
