// =========================================
// Prisma Client
// =========================================
generator client {
  provider = "prisma-client-js"
}

// =========================================
// Database
// =========================================
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================
// Enums
// =========================================

/**
 * Attachment type:
 * - IMAGE : image file attached to a message
 * - VIDEO : video file attached to a message
 */
enum AttachmentType {
  IMAGE
  VIDEO
}

/**
 * Release status:
 * - DRAFT    : private, not released
 * - RELEASED : receiver can see
 */
enum MemoryItemStatus {
  DRAFT
  RELEASED
}

/**
 * Optional: Collection status
 */
enum CollectionStatus {
  DRAFT
  ACTIVE
}

/**
 * User role for Admin review feature
 * - USER  : normal user
 * - ADMIN : can approve/reject ID verification
 */
enum UserRole {
  USER
  ADMIN
}

/**
 * Manual identity verification status (admin review queue)
 */
enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// =========================================
// NextAuth Models
// =========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =========================================
// App Models
// =========================================

model User {
  // =========================================
  // Primary Identity
  // =========================================
  id    String @id @default(cuid())
  email String @unique
  name  String

  // =========================================
  // Role / Admin
  // =========================================
  role UserRole @default(USER)

  // =========================================
  // Authentication
  // =========================================
  passwordHash String

  // =========================================
  // Mandatory Profile Fields
  // =========================================
  phoneNumber      String
  identificationNo String
  address          String

  // =========================================
  // Proof-of-Life System
  // =========================================
  lastConfirmedAt          DateTime?
  missedConfirmations      Int       @default(0)
  confirmationIntervalDays Int       @default(30)

  // =========================================
  // NextAuth Relations
  // =========================================
  accounts Account[]
  sessions Session[]

  // =========================================
  // App Relations (Owner side)
  // =========================================
  receivers   Receiver[]
  collections MemoryCollection[]
  items       MemoryItem[]

  // =========================================
  // Receiver Account Linking
  // =========================================
  linkedReceivers Receiver[] @relation("ReceiverLinkedUser")

  // =========================================
  // Identity verification requests
  // =========================================
  verificationRequests IdentityVerificationRequest[] @relation("VerificationRequester")

  // =========================================
  // Manual identity verification
  // =========================================
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  rejectReason       String?

  // =========================================
  // Verification Documents
  // =========================================
  verificationDocFrontUrl String?
  verificationDocBackUrl  String?

  // Optional: store Cloudinary public IDs too for cleanup
  verificationDocFrontPublicId String?
  verificationDocBackPublicId  String?

  // =========================================
  // Timestamps
  // =========================================
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Receiver {
  id String @id @default(cuid())

  // Owner of this receiver record
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Mandatory receiver details
  fullName         String
  email            String
  phone            String
  address          String
  identificationNo String

  // Invitation legacy fields
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  // Linked actual receiver account
  linkedUserId String?
  linkedUser   User?   @relation("ReceiverLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)

  // Collections that target this receiver
  collections MemoryCollection[]

  // Invite relation
  invites ReceiverInvite[]

  // Identity verification requests
  verificationRequests IdentityVerificationRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([ownerId])
  @@index([identificationNo])
}

model MemoryCollection {
  id String @id @default(cuid())

  // The "card" owner
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // The receiver for this card
  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  // Card title
  title String

  // Optional status
  status CollectionStatus @default(DRAFT)

  // Items inside this collection
  items MemoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([receiverId])
}

model MemoryItem {
  id String @id @default(cuid())

  // Parent collection (the "card")
  collectionId String
  collection   MemoryCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Owner (creator)
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Message title
  title String

  // Message text content
  content String

  // Optional per-item release date
  releaseDate DateTime?
  releasedAt  DateTime?

  // Release status
  status MemoryItemStatus @default(DRAFT)

  // Optional attachments (image/video)
  attachments MemoryAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([collectionId])
  @@index([releaseDate])
  @@index([status])
}

model MemoryAttachment {
  id String @id @default(cuid())

  // Parent message item
  itemId String
  item   MemoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Attachment type
  type AttachmentType

  // Cloudinary / media metadata
  mediaUrl      String
  mediaPublicId String
  mediaFileName String?
  mediaMimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([type])
}

model ReceiverInvite {
  id String @id @default(cuid())

  token String @unique

  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  // Snapshot info at invite generation time
  receiverEmail String
  receiverName  String?

  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([receiverId])
  @@index([createdAt])
}

/**
 * Admin review queue for Scenario A:
 * - Receiver clicks invite link
 * - Enters identificationNo + creates login email/password
 * - Uploads ID photo proof
 * - Admin reviews and approves
 * - After approve: Receiver.linkedUserId is set
 */
model IdentityVerificationRequest {
  id String @id @default(cuid())

  // Which receiver record is being claimed
  receiverId String
  receiver   Receiver @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  // Who is requesting
  requesterUserId String
  requesterUser   User   @relation("VerificationRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  // Which invite token was used
  inviteTokenUsed String?

  // Identification number submitted in the claim form
  identificationNoSubmitted String

  // Uploaded ID images
  idImageFrontUrl String
  idImageBackUrl  String?

  // Optional Cloudinary public IDs for cleanup
  idImageFrontPublicId String?
  idImageBackPublicId  String?

  // Admin review result
  status       VerificationStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedBy   String?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId])
  @@index([requesterUserId])
  @@index([status])
}